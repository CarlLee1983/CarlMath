{
  "name": "carlmath",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.0.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.ts",
    "build:e2e": "CARLMATH_CONTENT_DIR=tests/fixtures/site ASTRO_OUT_DIR=${ASTRO_OUT_DIR:-dist-e2e} astro build",
    "test:e2e": "pnpm build:e2e && playwright test",
    "deploy:dry": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.5.1",
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "astro": "7.3.8",
    "katex": "0.16.47",
    "postcss": "^8.5.30",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.150.0"
  }
}
