---
// 面積模型的一次性教具：長方形的兩邊各拆成位值（例如 23 拆成 20 和 3），每一塊標出面積。
// 上緣與左緣的數字是邊長（視同刻度數字），方塊裡的數字是該塊的面積；
// 文字標籤上限的「面積模型例外」（最多 2×2 共 4 格）見 docs/figure-guide.md。
import { assertAltText, figureIdPrefix } from "../../src/lib/figure-svg.ts";

interface Props {
  /** 圖的標題（必填，≤10 個字元），會成為 <title> */
  title: string;
  /** 圖的文字說明（必填），會成為 <desc> */
  desc: string;
  /** 橫邊拆成的幾段，1–2 段，由大到小，例如 [20, 3] */
  cols: number[];
  /** 縱邊拆成的幾段，1–2 段，由大到小，例如 [10, 4] */
  rows: number[];
  /** 要強調的那一列（從 0 算起）：這一列的方塊加粗框並淡淡塗色；不給就都不強調 */
  highlightRow?: number;
}
const props = Astro.props;
const { title, desc, cols, rows, highlightRow } = props;

assertAltText("AreaModelFigure", title, desc);
const valid = (a: unknown, max: number) =>
  Array.isArray(a) && a.length >= 1 && a.length <= max && a.every((n) => Number.isInteger(n) && n > 0);
if (!valid(cols, 2)) throw new Error("<AreaModelFigure> 的 cols 必須是 1 到 2 個正整數");
if (!valid(rows, 2)) throw new Error("<AreaModelFigure> 的 rows 必須是 1 到 2 個正整數");
if (highlightRow !== undefined && !(Number.isInteger(highlightRow) && highlightRow >= 0 && highlightRow < rows.length)) {
  throw new Error(`<AreaModelFigure> 的 highlightRow 超出 rows 範圍：${highlightRow}`);
}

const prefix = figureIdPrefix("am", props);

const WIDTH = 480;
const LEFT = 56; // 左緣留給縱邊的數字
const TOP = 36; // 上緣留給橫邊的數字
const GRID_W = 400;
const GRID_H = rows.length === 1 ? 110 : 190;
const MIN_W = 56;
const MIN_H = 48;

/** 依比例切開 avail，太窄的段先固定在下限，剩下的再按比例分 */
function split(values: number[], avail: number, min: number): number[] {
  const sizes = values.map(() => 0);
  let free = values.map((_, i) => i);
  let left = avail;
  for (;;) {
    const sum = free.reduce((s, i) => s + values[i], 0);
    const small = free.filter((i) => (values[i] / sum) * left < min);
    if (small.length === 0) {
      free.forEach((i) => (sizes[i] = (values[i] / sum) * left));
      return sizes;
    }
    small.forEach((i) => (sizes[i] = min));
    left -= small.length * min;
    free = free.filter((i) => !small.includes(i));
    if (free.length === 0) return sizes;
  }
}

const colW = split(cols, GRID_W, MIN_W);
const rowH = split(rows, GRID_H, MIN_H);
const xs = colW.map((_, i) => LEFT + colW.slice(0, i).reduce((s, n) => s + n, 0));
const ys = rowH.map((_, i) => TOP + rowH.slice(0, i).reduce((s, n) => s + n, 0));
const height = TOP + GRID_H + 12;

const blocks = rows.flatMap((r, ri) =>
  cols.map((c, ci) => ({
    x: xs[ci],
    y: ys[ri],
    w: colW[ci],
    h: rowH[ri],
    area: r * c,
    hi: ri === highlightRow,
  })),
);
---

<svg class="am-fig" viewBox={`0 0 ${WIDTH} ${height}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
  <title id={`${prefix}-title`}>{title}</title>
  <desc id={`${prefix}-desc`}>{desc}</desc>
  {blocks.map((b) => <rect class={b.hi ? "am-block am-hi" : "am-block"} x={b.x} y={b.y} width={b.w} height={b.h} />)}
  {cols.map((c, i) => <text class="am-dim" x={xs[i] + colW[i] / 2} y={TOP - 10}>{c}</text>)}
  {rows.map((r, i) => <text class="am-dim am-dim-left" x={LEFT - 10} y={ys[i] + rowH[i] / 2 + 7}>{r}</text>)}
  {blocks.map((b) => <text class="am-area" x={b.x + b.w / 2} y={b.y + b.h / 2 + 7}>{b.area}</text>)}
</svg>

<style>
  /* 選擇器多疊一層屬性，優先於 lesson.css 的 figure.fig svg { max-width: 100% }，寬螢幕上才會停在 32rem */
  svg.am-fig[role="img"] {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin: 0 auto;
  }
  .am-block {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2px;
    stroke-linejoin: round;
  }
  /* 強調的那一列：除了 --accent 淡淡塗色，框線也加粗，顏色不是唯一訊息 */
  .am-hi {
    fill: var(--accent);
    fill-opacity: 0.22;
    stroke: var(--accent);
    stroke-width: 3px;
  }
  .am-dim,
  .am-area {
    fill: var(--fg);
    font-size: 22px;
    text-anchor: middle;
  }
  .am-dim-left {
    text-anchor: end;
  }
</style>
