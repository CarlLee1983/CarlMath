---
// 量角器內外圈讀法的一次性教具：半圓量角器，外圈從右邊的 0 往左數到 180，內圈從左邊的 0 往右數到 180。
// 角的一邊放在 0 那一側的底線上，另一邊的射線指到的數字，要讀「從那個 0 開始數」的那一圈。
// zero="right"：底線那條邊朝右，讀外圈；zero="left"：底線那條邊朝左，讀內圈。degrees 是角的實際大小。
import { assertAltText, figureIdPrefix } from "../../src/lib/figure-svg.ts";

interface Props {
  /** 圖的標題（必填，≤10 個字元），會成為 <title> */
  title: string;
  /** 圖的文字說明（必填），會成為 <desc> */
  desc: string;
  /** 角的一邊（底線那條）朝哪一側，那一側的 0 就是起點 */
  zero: "right" | "left";
  /** 角的大小，1–179 的整數，不是 30 的倍數（射線才不會壓在刻度數字上） */
  degrees: number;
}
const props = Astro.props;
const { title, desc, zero, degrees } = props;

assertAltText("ProtractorFigure", title, desc);
if (zero !== "right" && zero !== "left") throw new Error(`<ProtractorFigure> 的 zero 必須是 "right" 或 "left"：${zero}`);
if (!Number.isInteger(degrees) || degrees < 1 || degrees > 179 || degrees % 30 === 0) {
  throw new Error(`<ProtractorFigure> 的 degrees 必須是 1 到 179、不是 30 的倍數的整數：${degrees}`);
}

const prefix = figureIdPrefix("pro", props);

const WIDTH = 480;
const CX = 240;
const CY = 232;
const R = 206; // 量角器外緣
const R_INNER = 146; // 內外圈的分界
const RAY = R + 8;
const HEIGHT = CY + 16;
const rad = (d: number) => (d * Math.PI) / 180;
const f = (n: number) => Math.round(n * 10) / 10;
// 從圓心出發、方向 d 度（由右邊逆時針量）、距離 r 的點
const at = (d: number, r: number) => ({ x: f(CX + r * Math.cos(rad(d))), y: f(CY - r * Math.sin(rad(d))) });

const marks = Array.from({ length: 19 }, (_, i) => i * 10);
const outerTicks = marks.map((d) => {
  const a = at(d, R);
  const b = at(d, R - (d % 30 === 0 ? 16 : 9));
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y };
});
// 內圈的刻度從分界線往圓心畫；內圈的 d 度，在由右邊量起的 180 - d 度的位置
const innerTicks = marks.map((d) => {
  const a = at(180 - d, R_INNER);
  const b = at(180 - d, R_INNER - (d % 30 === 0 ? 14 : 8));
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y };
});
// 刻度數字只標 30 的倍數；0 與 180 在底線上，往上抬一點避免壓到射線
const lift = (d: number, p: { x: number; y: number }) => (d === 0 || d === 180 ? { x: p.x + (d === 0 ? -6 : 6), y: p.y - 16 } : p);
const outerNums = [0, 30, 60, 90, 120, 150, 180].map((d) => ({ text: d, ...lift(d, at(d, 172)) }));
const innerNums = [0, 30, 60, 90, 120, 150, 180].map((d) => ({ text: d, ...lift(180 - d, at(180 - d, 112)) }));

const baseDir = zero === "right" ? 0 : 180;
const rayDir = zero === "right" ? degrees : 180 - degrees;
const baseEnd = at(baseDir, RAY);
const rayEnd = at(rayDir, RAY);
const arcR = 56;
const arcStart = at(baseDir, arcR);
const arcEnd = at(rayDir, arcR);
// 由右邊逆時針量時，從 0 側起轉：zero=right 逆時針（sweep 0），zero=left 順時針（sweep 1）
const arcSweep = zero === "right" ? 0 : 1;
---

<svg class="pro-fig" viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
  <title id={`${prefix}-title`}>{title}</title>
  <desc id={`${prefix}-desc`}>{desc}</desc>
  <path class="pro-body" d={`M ${CX - R} ${CY} A ${R} ${R} 0 0 1 ${CX + R} ${CY} Z`} />
  <path class="pro-ring" d={`M ${CX - R_INNER} ${CY} A ${R_INNER} ${R_INNER} 0 0 1 ${CX + R_INNER} ${CY}`} />
  {outerTicks.map((t) => <line class="pro-tick" x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
  {innerTicks.map((t) => <line class="pro-tick" x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
  {outerNums.map((n) => <text class="pro-num" x={n.x} y={n.y + 7}>{n.text}</text>)}
  {innerNums.map((n) => <text class="pro-num" x={n.x} y={n.y + 7}>{n.text}</text>)}
  <line class="pro-ray" x1={CX} y1={CY} x2={baseEnd.x} y2={baseEnd.y} />
  <line class="pro-ray" x1={CX} y1={CY} x2={rayEnd.x} y2={rayEnd.y} />
  <path class="pro-arc" d={`M ${arcStart.x} ${arcStart.y} A ${arcR} ${arcR} 0 0 ${arcSweep} ${arcEnd.x} ${arcEnd.y}`} />
  <circle class="pro-dot" cx={CX} cy={CY} r="5" />
</svg>

<style>
  /* 選擇器多疊一層屬性，優先於 lesson.css 的 figure.fig svg { max-width: 100% }，寬螢幕上才會停在 32rem */
  svg.pro-fig[role="img"] {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin: 0 auto;
  }
  .pro-body {
    fill: none;
    stroke: var(--fg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  /* 內外圈的分界與刻度是輔助線 */
  .pro-ring {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2px;
  }
  .pro-tick {
    stroke: var(--muted);
    stroke-width: 2px;
    stroke-linecap: round;
  }
  .pro-ray {
    stroke: var(--fg);
    stroke-width: 3px;
    stroke-linecap: round;
  }
  .pro-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5px;
    stroke-linecap: round;
  }
  .pro-dot {
    fill: var(--fg);
  }
  .pro-num {
    fill: var(--fg);
    font-size: 22px;
    text-anchor: middle;
  }
</style>
