---
// 百分率的一次性百格圖：一個正方形平分成 10 × 10 共 100 格，從左上角起一列一列塗滿 shaded 格。
// 塗色的格子以 --accent 實心填滿，沒塗的格子只有框線，灰階下也分得出來；
// 可選的 label 畫在格子右側（例如「65%」），是圖內唯一的文字標籤。
import { assertAltText, figureIdPrefix } from "../../src/lib/figure-svg.ts";

interface Props {
  /** 圖的標題（必填，≤10 個字元），會成為 <title> */
  title: string;
  /** 圖的文字說明（必填），會成為 <desc> */
  desc: string;
  /** 塗滿幾格，0–100 的整數；從左上角開始，一列塗滿 10 格再換下一列 */
  shaded: number;
  /** 畫在格子右側的文字，例如「65%」；不給就不畫 */
  label?: string;
}
const props = Astro.props;
const { title, desc, shaded, label } = props;

assertAltText("PercentGridFigure", title, desc);
if (!(Number.isInteger(shaded) && shaded >= 0 && shaded <= 100)) {
  throw new Error(`<PercentGridFigure> 的 shaded 必須是 0 到 100 的整數：${shaded}`);
}
if (label !== undefined && (typeof label !== "string" || label.trim() === "" || [...label].length > 6)) {
  throw new Error("<PercentGridFigure> 的 label 必須是 1 到 6 個字元的文字");
}

const prefix = figureIdPrefix("pct", props);

const WIDTH = 480;
const CELL = 30;
const SIZE = CELL * 10; // 300
const EDGE = 4; // 上下留給外框線寬的邊
const LABEL_ROOM = label ? 110 : 0;
const left = (WIDTH - SIZE - LABEL_ROOM) / 2;
const top = EDGE;
const height = SIZE + EDGE * 2;

const cells = Array.from({ length: 100 }, (_, i) => ({
  x: left + (i % 10) * CELL,
  y: top + Math.floor(i / 10) * CELL,
  on: i < shaded,
}));
const inner = Array.from({ length: 9 }, (_, k) => (k + 1) * CELL);
---

<svg class="pct-fig" viewBox={`0 0 ${WIDTH} ${height}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
  <title id={`${prefix}-title`}>{title}</title>
  <desc id={`${prefix}-desc`}>{desc}</desc>
  {cells.filter((c) => c.on).map((c) => <rect class="pct-on" x={c.x} y={c.y} width={CELL} height={CELL} />)}
  {inner.map((d) => <line class="pct-grid" x1={left + d} y1={top} x2={left + d} y2={top + SIZE} />)}
  {inner.map((d) => <line class="pct-grid" x1={left} y1={top + d} x2={left + SIZE} y2={top + d} />)}
  <rect class="pct-frame" x={left} y={top} width={SIZE} height={SIZE} />
  {label && <text class="pct-label" x={left + SIZE + LABEL_ROOM / 2 + 6} y={top + SIZE / 2 + 8}>{label}</text>}
</svg>

<style>
  /* 選擇器多疊一層屬性，優先於 lesson.css 的 figure.fig svg { max-width: 100% }，寬螢幕上才會停在 32rem */
  svg.pct-fig[role="img"] {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin: 0 auto;
  }
  .pct-on {
    fill: var(--accent);
    stroke: none;
  }
  .pct-grid {
    stroke: var(--muted);
    stroke-width: 2px;
    stroke-linecap: round;
  }
  .pct-frame {
    fill: none;
    stroke: var(--fg);
    stroke-width: 3px;
    stroke-linejoin: round;
  }
  .pct-label {
    fill: var(--fg);
    font-size: 22px;
    text-anchor: middle;
  }
</style>
