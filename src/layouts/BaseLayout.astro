---
import SiteNav from "../components/SiteNav.astro";
import Document from "./Document.astro";

interface Props {
  title: string;
  description?: string;
  /** 不讓搜尋引擎收錄（未撰寫的單元頁） */
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<Document title={title} description={description} noindex={noindex}>
  <header class="site-header">
    <div class="site-header-inner">
      <SiteNav />
    </div>
  </header>
  <main class="page">
    <slot />
  </main>
</Document>
