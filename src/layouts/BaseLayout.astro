---
import SiteNav from "../components/SiteNav.astro";
import Document from "./Document.astro";

interface Props {
  title: string;
  description?: string;
  /** 不讓搜尋引擎收錄（未撰寫的單元頁） */
  noindex?: boolean;
  /** 滿版頁面（首頁）：main 不套 .page 的置中窄欄，版面由頁面自己決定 */
  fullBleed?: boolean;
}
const { title, description, noindex, fullBleed = false } = Astro.props;
---

<Document title={title} description={description} noindex={noindex}>
  <header class="site-header">
    <div class="site-header-inner">
      <SiteNav />
    </div>
  </header>
  <main class={fullBleed ? "page-full" : "page"}>
    <slot />
  </main>
</Document>
