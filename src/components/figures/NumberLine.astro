---
import { assertAltText, figureIdPrefix } from "../../lib/figure-svg.ts";
import { resolveNumberLine } from "../../lib/number-line-scale.ts";
import type { NumberLineMove, NumberLineRay, Position } from "../../lib/number-line-scale.ts";
import { STACKED_HEIGHT, isStacked } from "../../lib/stacked-fraction.ts";
import StackedFraction from "./StackedFraction.astro";

interface Point {
  at: Position;
  label?: string;
}
interface Props {
  /** 圖的標題（必填，≤10 個字元），會成為 <title> */
  title: string;
  /** 圖的文字說明（必填），會成為 <desc>，給讀圖軟體與看不到圖的人 */
  desc: string;
  /** 位置值：數字（取十進位字面，0.1 就是 1/10）或 "a/b" 字串 */
  from: Position;
  to: Position;
  /** 刻度間隔；寫成 "a/b" 字串時刻度標疊排分數，寫成數字時標十進位小數 */
  step?: Position;
  /** 只標這個數的倍數（須是 step 的倍數）；預設 10 段以內每格標，超過時整數數線標 5 的倍數、分數與小數數線只標整數 */
  labelEvery?: Position;
  /** 大於 1 的分數刻度寫成帶分數；只能搭配 "a/b" 寫法的 step */
  mixed?: boolean;
  points?: Point[];
  jumps?: NumberLineMove[];
  spans?: NumberLineMove[];
  /** 單邊射線（不等式的解）：從 from 往 direction 延伸到數線那一端並帶箭頭；open 為真是空心端點（不含），否則實心（含）。不帶標籤 */
  rays?: NumberLineRay[];
}
const props = Astro.props;
const { title, desc, from, to, step = 1, labelEvery, mixed, points = [], jumps = [], spans = [], rays = [] } = props;

assertAltText("NumberLine", title, desc);

const scale = resolveNumberLine({ from, to, step, labelEvery, mixed, points, jumps, spans, rays });
const { ticks, numbers, hasStacked, margin } = scale;

const prefix = figureIdPrefix("nl", props);

// 版面（viewBox 單位）：左右留邊讓兩端數字不被裁切，邊界由模組依端點標籤的寬度算出
const WIDTH = 480;
// 模組回傳的位置都是占整條線的比例（0 到 1）
const x = (t: number) => margin.left + t * (WIDTH - margin.left - margin.right);

// 垂直方向由軸線往上、往下各自累加所需高度，不留大片空白
const TICK_HALF = 7;
const ZERO_TICK_HALF = 12;
const LIFT = 12; // 跳躍弧離軸線的距離，避免蓋住點與刻度
const arcHeight = (m: NumberLineMove<number>) => Math.min(18 + 0.2 * Math.abs(x(m.to) - x(m.from)), 56);
const maxArc = Math.max(0, ...scale.jumps.map(arcHeight));
const jumpLabelRoom = scale.jumps.some((j) => j.label) ? 26 : 6;
const pointLabelRoom = scale.points.some((p) => p.label) ? 38 : 14;
const axisY = Math.ceil(Math.max(pointLabelRoom, scale.jumps.length ? LIFT + maxArc + jumpLabelRoom : 0, 14));
// 數線下方的刻度標籤：有疊排分數時，整數與分數並排在分數線的高度，整體高度是疊排分數的高度，否則是一行數字
const STACK_TOP = 18; // 疊排分數上緣離軸線的距離
const numY = hasStacked ? axisY + STACK_TOP + 31 : axisY + 36;
const labelsBottom = hasStacked ? axisY + STACK_TOP + STACKED_HEIGHT : numY;
const spanY = labelsBottom + 18;
const spanLabelY = spanY + 23;
const height = scale.spans.length ? (scale.spans.some((s) => s.label) ? spanLabelY + 8 : spanY + 8) : labelsBottom + 8;

const jumpPath = (m: NumberLineMove<number>) => {
  const [x1, x2, y] = [x(m.from), x(m.to), axisY - LIFT];
  return `M ${x1} ${y} Q ${(x1 + x2) / 2} ${y - 2 * arcHeight(m)} ${x2} ${y}`;
};
const bracketPath = (m: NumberLineMove<number>) => {
  const [x1, x2] = [x(m.from), x(m.to)];
  return `M ${x1} ${spanY - 8} V ${spanY} H ${x2} V ${spanY - 8}`;
};
---

<svg class="nl-fig" viewBox={`0 0 ${WIDTH} ${height}`} role="img" aria-labelledby={`${prefix}-title ${prefix}-desc`}>
  <title id={`${prefix}-title`}>{title}</title>
  <desc id={`${prefix}-desc`}>{desc}</desc>
  {
    (scale.jumps.length > 0 || scale.rays.length > 0) && (
      <defs>
        <marker id={`${prefix}-arrow`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto">
          <path class="nl-arrow" d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>
    )
  }
  <line class="nl-axis" x1={margin.left} y1={axisY} x2={WIDTH - margin.right} y2={axisY} />
  {
    ticks.map((t) => (
      <line
        class={t.isZero ? "nl-tick nl-tick-zero" : "nl-tick"}
        x1={x(t.at)}
        y1={axisY - (t.isZero ? ZERO_TICK_HALF : TICK_HALF)}
        x2={x(t.at)}
        y2={axisY + (t.isZero ? ZERO_TICK_HALF : TICK_HALF)}
      />
    ))
  }
  {
    numbers.map(({ at, label }) =>
      isStacked(label) ? (
        <StackedFraction cx={x(at)} top={axisY + STACK_TOP} negative={label.negative} whole={label.kind === "mixed" ? label.whole : undefined} numerator={label.numerator} denominator={label.denominator} />
      ) : (
        <text class="nl-num" x={x(at)} y={numY}>{label.text}</text>
      ),
    )
  }
  {scale.rays.map((r) => <line class="nl-ray" x1={x(r.at)} y1={axisY} x2={x(r.end)} y2={axisY} marker-end={`url(#${prefix}-arrow)`} />)}
  {scale.rays.map((r) => <circle class={r.open ? "nl-ray-end nl-ray-open" : "nl-ray-end"} cx={x(r.at)} cy={axisY} r="7" />)}
  {scale.points.map((p) => <circle class="nl-point" cx={x(p.at)} cy={axisY} r="7" />)}
  {scale.points.filter((p) => p.label).map((p) => <text class="nl-label" x={x(p.at)} y={axisY - 16}>{p.label}</text>)}
  {scale.jumps.map((j) => <path class="nl-jump" d={jumpPath(j)} marker-end={`url(#${prefix}-arrow)`} />)}
  {
    scale.jumps
      .filter((j) => j.label)
      .map((j) => (
        <text class="nl-label" x={(x(j.from) + x(j.to)) / 2} y={axisY - LIFT - arcHeight(j) - 8}>
          {j.label}
        </text>
      ))
  }
  {scale.spans.map((s) => <path class="nl-span" d={bracketPath(s)} />)}
  {scale.spans.filter((s) => s.label).map((s) => <text class="nl-label" x={(x(s.from) + x(s.to)) / 2} y={spanLabelY}>{s.label}</text>)}
</svg>

<style>
  /* 選擇器多疊一層屬性，優先於 lesson.css 的 figure.fig svg { max-width: 100% }，寬螢幕上才會停在 32rem */
  svg.nl-fig[role="img"] {
    display: block;
    width: 100%;
    max-width: 32rem;
    height: auto;
    margin: 0 auto;
  }
  .nl-axis {
    stroke: var(--fg);
    stroke-width: 3px;
    stroke-linecap: round;
  }
  .nl-tick {
    stroke: var(--muted);
    stroke-width: 2px;
    stroke-linecap: round;
  }
  .nl-tick-zero {
    stroke-width: 3px;
  }
  .nl-num {
    fill: var(--fg);
    font-size: 22px;
    text-anchor: middle;
  }
  .nl-label {
    fill: var(--fg);
    font-size: 20px;
    text-anchor: middle;
  }
  .nl-point {
    fill: var(--accent);
  }
  .nl-ray {
    stroke: var(--accent);
    stroke-width: 5px;
  }
  .nl-ray-end {
    fill: var(--accent);
    stroke: var(--accent);
    stroke-width: 3px;
  }
  .nl-ray-open {
    fill: var(--bg);
  }
  .nl-jump {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.5px;
    stroke-linecap: round;
  }
  .nl-arrow {
    fill: var(--accent);
  }
  .nl-span {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
