---
// 疊排分數（SVG 片段，只能放在 <svg> 內）：分子、分數線、分母上下排，帶分數的整數部分並排在左。
// 數線的刻度標籤與分數條的標籤共用它，兩個教具的分數長得一樣；版面計算在 src/lib/stacked-fraction.ts。
import { stackedFractionLayout } from "../../lib/stacked-fraction.ts";
import type { StackedFractionParts } from "../../lib/stacked-fraction.ts";

interface Props extends StackedFractionParts {
  /** 整體的水平中心 */
  cx: number;
  /** 整體的上緣 */
  top: number;
}
const { cx, top, ...parts } = Astro.props;
const layout = stackedFractionLayout(parts, cx, top);
---

<g class="sf">
  {layout.whole && <text class="sf-whole" x={layout.whole.x} y={layout.whole.y}>{layout.whole.text}</text>}
  <text class="sf-num" x={layout.numerator.x} y={layout.numerator.y}>{layout.numerator.text}</text>
  <line class="sf-bar" x1={layout.bar.x1} y1={layout.bar.y} x2={layout.bar.x2} y2={layout.bar.y} />
  <text class="sf-den" x={layout.denominator.x} y={layout.denominator.y}>{layout.denominator.text}</text>
</g>

<style>
  .sf-whole,
  .sf-num,
  .sf-den {
    fill: var(--fg);
    font-size: 22px;
    text-anchor: middle;
  }
  /* 分數線與數線刻度同寬 */
  .sf-bar {
    stroke: var(--fg);
    stroke-width: 2px;
    stroke-linecap: round;
  }
</style>
