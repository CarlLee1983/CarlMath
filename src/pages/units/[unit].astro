---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { contentRoot } from "../../content/content-dir";
import { loadValidContent } from "../../lib/content";
import UnitLinks, { type UnitLink } from "../../components/UnitLinks.astro";
import { shareImageMeta, unitShareCard } from "../../lib/share-cards";
import { unitBreadcrumbJsonLd } from "../../lib/structured-data";
import { gradeLabel } from "../../lib/grade-label";
import { lessonComponents } from "../../components/lesson";
import FamilyReadingLayout from "../../layouts/FamilyReadingLayout.astro";
import SidebarReadingLayout from "../../layouts/SidebarReadingLayout.astro";
import "../../styles/lesson.css";

// 單元頁由課程地圖產生：每個單元一頁，已有教材的渲染教材，其餘顯示「尚未撰寫」。
export async function getStaticPaths() {
  const { index } = loadValidContent(contentRoot());
  const lessons = new Map((await getCollection("lessons")).map((entry) => [entry.data.unit, entry]));
  const toUnitLink = (unit: { id: string; title: string }): UnitLink => ({
    id: unit.id,
    title: unit.title,
    written: index.isWritten(unit.id),
  });
  const toNeighbor = (unit: { id: string; title: string } | null) => (unit ? toUnitLink(unit) : null);
  return index.units.map((unit) => {
    const step = index.nextStep(unit.id);
    const written = index.isWritten(unit.id);
    const entry = lessons.get(unit.id);
    // 未撰寫的單元：遞移先修裡、依閱讀順序最後（最接近它）的一篇已撰寫單元，就是現在能先讀的
    const readNow = written ? undefined : index.transitivePrerequisites(unit.id).filter((pre) => index.isWritten(pre.id)).at(-1);
    if (written && !entry) throw new Error(`單元「${unit.id}」已撰寫，但教材 collection 找不到它`);
    return {
      params: { unit: unit.id },
      props: {
        unit,
        written,
        entry,
        stageTitle: index.stageOf(unit.id).title,
        stageId: index.stageOf(unit.id).id,
        grades: gradeLabel(index.gradeRange(unit.id)),
        prerequisites: index.prerequisites(unit.id).map(toUnitLink),
        dependents: index.dependents(unit.id).map(toUnitLink),
        suggested: index.transitivePrerequisites(unit.id).map(toUnitLink),
        stageUnits: index.stageOf(unit.id).units.map(toUnitLink),
        previous: toNeighbor(index.previous(unit.id)),
        next: toNeighbor(index.next(unit.id)),
        nextStep: { kind: step.kind, units: step.units.map(toUnitLink) },
        readNow: readNow ? { id: readNow.id, title: readNow.title, coreQuestion: readNow.coreQuestion } : null,
      },
    };
  });
}

const { unit, written, entry, stageTitle, stageId, grades, prerequisites, dependents, suggested, stageUnits, previous, next, nextStep, readNow } =
  Astro.props;
const rendered = written && entry ? await render(entry) : null;
const Content = rendered?.Content ?? null;
const description = entry?.data.description ?? unit.coreQuestion;
const title = `${unit.title}｜CarlMath`;
// 已撰寫單元用自己的分享圖；未撰寫的沿用文件外殼的預設圖
const image = shareImageMeta(unitShareCard(unit, stageTitle), Astro.site!);
const jsonLd = unitBreadcrumbJsonLd(Astro.site!, { id: stageId, title: stageTitle }, unit);
---

{
  Content && rendered ? (
    unit.family ? (
      <FamilyReadingLayout
        title={title}
        description={description}
        modifiedTime={entry?.data.updated}
        image={image}
        jsonLd={jsonLd}
        unit={unit}
        stageTitle={stageTitle}
        suggested={suggested}
        previous={previous}
        next={next}
        nextStep={nextStep}
      >
        <Content components={lessonComponents} />
      </FamilyReadingLayout>
    ) : (
      <SidebarReadingLayout
        title={title}
        description={description}
        modifiedTime={entry?.data.updated}
        image={image}
        jsonLd={jsonLd}
        unit={unit}
        stageTitle={stageTitle}
        stageUnits={stageUnits}
        grades={grades}
        prerequisites={prerequisites}
        suggested={suggested}
        previous={previous}
        next={next}
        nextStep={nextStep}
        sections={rendered.headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ slug, text }))}
      >
        <Content components={lessonComponents} />
      </SidebarReadingLayout>
    )
  ) : (
    <BaseLayout title={title} description={description} noindex={!written}>
      <div class="unit-head">
        <h1>{unit.title}</h1>
        <p class="unit-core">{unit.coreQuestion}</p>
        <p class="unit-meta">
          <span class="unit-status">尚未撰寫</span>
          <span>{stageTitle}</span>
          <span>{grades}</span>
          {unit.family && <span class="unit-family">親子共學</span>}
        </p>
      </div>
      <section class="unit-read-now" aria-labelledby="read-now">
        <h2 id="read-now">現在可以先讀</h2>
        {
          readNow ? (
            <>
              <p>這篇還沒寫好。它的先修裡，離它最近的已撰寫單元是：</p>
              <p class="read-now-title">
                <a href={`/units/${readNow.id}/`}>{readNow.title}</a>
              </p>
              <p class="read-now-core">{readNow.coreQuestion}</p>
            </>
          ) : (
            <p>
              這篇還沒寫好，它的先修也都還沒寫。可以先從<a href="/map/?written=1">已撰寫的單元</a>挑一篇讀。
            </p>
          )
        }
      </section>
      <section aria-labelledby="direct-prerequisites">
        <h2 id="direct-prerequisites">直接先修</h2>
        {prerequisites.length > 0 ? <UnitLinks units={prerequisites} /> : <p>這個單元沒有先修，可以直接開始。</p>}
      </section>
      <section aria-labelledby="dependents">
        <h2 id="dependents">學完可接</h2>
        {dependents.length > 0 ? <UnitLinks units={dependents} /> : <p>目前沒有其他單元以它為先修。</p>}
      </section>
      <section aria-labelledby="suggested-reading">
        <h2 id="suggested-reading">建議先讀</h2>
        {suggested.length > 0 ? <UnitLinks units={suggested} ordered /> : <p>不需要先讀其他單元。</p>}
      </section>
    </BaseLayout>
  )
}
