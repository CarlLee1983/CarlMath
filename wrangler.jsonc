{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carlmath",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "math.gravito.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
